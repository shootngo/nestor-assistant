# Kitchen brain key. Copy to `.env` and fill in **one** of these. Never commit `.env`.
# Get a key at https://aistudio.google.com/apikey
# Rebuild the APK after changing this — the value is baked in at bundle time.
#
# Either name works:
#   EXPO_PUBLIC_GEMINI_API_KEY   Expo's public inline slot
#   GEMINI_API_KEY               same key (Grok box / EAS secret / plain env)
EXPO_PUBLIC_GEMINI_API_KEY=
GEMINI_API_KEY=
