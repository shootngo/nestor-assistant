# Kitchen brain + tablet household sign-in. Copy to `.env` and fill in.
# Never commit `.env`. Rebuild the APK after changing these — values are baked in at bundle time.
#
# Gemini (either name):
#   EXPO_PUBLIC_GEMINI_API_KEY
#   GEMINI_API_KEY
EXPO_PUBLIC_GEMINI_API_KEY=
GEMINI_API_KEY=

# Tablet Email/Password (must be a household email in firestore.rules).
# Either the plain names or EXPO_PUBLIC_ variants work.
NESTOR_TABLET_EMAIL=
NESTOR_TABLET_PASSWORD=
# EXPO_PUBLIC_NESTOR_TABLET_EMAIL=
# EXPO_PUBLIC_NESTOR_TABLET_PASSWORD=

# Optional Firebase web config overrides. Defaults are the public nestor-c2ae8 keys
# (same as shootngo/Nestor js/config.js). Do not create a new Firebase project.
# NESTOR_FIREBASE_API_KEY=
# NESTOR_FIREBASE_AUTH_DOMAIN=
# NESTOR_FIREBASE_PROJECT_ID=
# NESTOR_FIREBASE_STORAGE_BUCKET=
# NESTOR_FIREBASE_MESSAGING_SENDER_ID=
# NESTOR_FIREBASE_APP_ID=
