# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
local.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (Gemini key lives here locally; never commit it)
.env
.env.*
!.env.example
.env*.local

# typescript
*.tsbuildinfo

# generated native folders (Continuous Native Generation)
/ios
/android

# installable binaries
*.apk
*.aab
*.ipa

# local Expo module Gradle outputs
modules/*/android/build/
